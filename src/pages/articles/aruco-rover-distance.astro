---
// ArUcoでローバーの距離を測る（aruco-rover-distance-guide.html から移植）
import ArticlePage from '../../layouts/ArticlePage.astro';
---

<ArticlePage id="aruco-rover-distance" description="起伏のある砂地を走るローバーで、ArUcoマーカーから距離を推定するための図解ガイド。座標系、PnP、距離の種類、地面距離への変換、OpenCV実装を説明する。">
<Fragment slot="head">
<style is:inline>
  :root {
    --ground: #e8ebef;
    --surface: #f3f5f7;
    --panel: #ffffff;
    --ink: #17202b;
    --ink-2: #465363;
    --muted: #74808d;
    --line: #c8cfd7;
    --line-soft: #e1e5ea;
    --blue: #176b87;
    --blue-soft: #e5f2f6;
    --orange: #bd6415;
    --orange-soft: #fff0df;
    --green: #397653;
    --green-soft: #e8f3ec;
    --red: #a73f3b;
    --red-soft: #f9e9e8;
    --violet: #6555a3;
    --shadow: 0 14px 35px rgb(32 43 54 / 8%);
    --serif: "Hiragino Mincho ProN", "Yu Mincho", YuMincho, "Noto Serif CJK JP", serif;
    --sans: "Hiragino Sans", "Noto Sans CJK JP", "Yu Gothic", YuGothic, Meiryo, system-ui, sans-serif;
    --mono: ui-monospace, "SFMono-Regular", "Cascadia Code", "Roboto Mono", Menlo, Consolas, monospace;
  }

  :root[data-theme="dark"] {
    --ground: #10161d;
    --surface: #171e27;
    --panel: #1c2530;
    --ink: #e6ebf1;
    --ink-2: #b4bfcb;
    --muted: #8793a0;
    --line: #3b4653;
    --line-soft: #2a3440;
    --blue: #69bad2;
    --blue-soft: #173640;
    --orange: #f0aa63;
    --orange-soft: #402c1b;
    --green: #83c59a;
    --green-soft: #203b2a;
    --red: #ed8c86;
    --red-soft: #412525;
    --violet: #b2a4ed;
    --shadow: 0 14px 35px rgb(0 0 0 / 25%);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground: #10161d;
      --surface: #171e27;
      --panel: #1c2530;
      --ink: #e6ebf1;
      --ink-2: #b4bfcb;
      --muted: #8793a0;
      --line: #3b4653;
      --line-soft: #2a3440;
      --blue: #69bad2;
      --blue-soft: #173640;
      --orange: #f0aa63;
      --orange-soft: #402c1b;
      --green: #83c59a;
      --green-soft: #203b2a;
      --red: #ed8c86;
      --red-soft: #412525;
      --violet: #b2a4ed;
      --shadow: 0 14px 35px rgb(0 0 0 / 25%);
    }
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.85;
    -webkit-font-smoothing: antialiased;
  }

  a { color: var(--blue); text-underline-offset: .18em; }
  a:hover { text-decoration-thickness: 2px; }
  button, input { font: inherit; }

  .page {
    width: min(1160px, calc(100% - 32px));
    margin: 0 auto;
    padding: 34px 0 96px;
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 54px;
  }

  .brand {
    color: var(--muted);
    font: 700 11px/1 var(--mono);
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .theme-button {
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
  }

  header {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(330px, .95fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
    margin-bottom: 72px;
  }

  h1, h2, h3 { font-family: var(--serif); }

  h1 {
    margin: 0 0 22px;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.25;
    letter-spacing: .02em;
    text-wrap: balance;
  }

  h2 {
    margin: 0;
    font-size: clamp(25px, 3.2vw, 34px);
    line-height: 1.45;
    letter-spacing: .02em;
  }

  h3 {
    margin: 0;
    font-size: 21px;
    line-height: 1.5;
  }

  p { margin: 0; }
  strong { font-weight: 700; }
  var { font-family: var(--serif); }

  .lede {
    max-width: 42em;
    color: var(--ink-2);
    font-size: 17px;
  }

  .verdict {
    margin-top: 26px;
    padding: 18px 20px;
    border-left: 4px solid var(--green);
    background: var(--green-soft);
    color: var(--ink);
  }

  .hero-figure, .figure {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .figure-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--line-soft);
    background: var(--surface);
    color: var(--muted);
    font: 700 11px/1.5 var(--mono);
    letter-spacing: .08em;
  }

  .figure-body { padding: clamp(14px, 2.6vw, 28px); }
  svg { display: block; width: 100%; height: auto; }

  .layout {
    display: grid;
    grid-template-columns: 225px minmax(0, 1fr);
    gap: clamp(32px, 6vw, 76px);
    align-items: start;
  }

  nav {
    position: sticky;
    top: 24px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  nav p {
    margin-bottom: 10px;
    color: var(--muted);
    font: 700 11px/1.4 var(--mono);
    letter-spacing: .12em;
  }

  nav ol { margin: 0; padding-left: 22px; }
  nav li { margin: 5px 0; color: var(--muted); }
  nav a { color: var(--ink-2); text-decoration: none; }
  nav a:hover { color: var(--blue); text-decoration: underline; }

  main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 82px;
  }

  section { scroll-margin-top: 24px; }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }

  .section-no {
    color: var(--orange);
    font: 700 11px/1 var(--mono);
    letter-spacing: .14em;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 48em;
    color: var(--ink-2);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 24px;
  }

  .card {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
  }

  .card .tag {
    display: inline-block;
    margin-bottom: 10px;
    padding: 3px 8px;
    border-radius: 999px;
    color: var(--green);
    background: var(--green-soft);
    font: 700 11px/1.5 var(--mono);
  }

  .card .tag.caution { color: var(--red); background: var(--red-soft); }
  .card h3 { margin-bottom: 8px; }
  .card p { color: var(--ink-2); font-size: 14px; }

  .table-wrap {
    margin-top: 24px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 680px;
    font-size: 14px;
  }

  th, td {
    padding: 13px 15px;
    border-bottom: 1px solid var(--line-soft);
    text-align: left;
    vertical-align: top;
  }

  th { background: var(--surface); color: var(--ink); font-weight: 700; }
  td { color: var(--ink-2); }
  tr:last-child td { border-bottom: 0; }
  .yes { color: var(--green); font-weight: 700; }
  .conditional { color: var(--orange); font-weight: 700; }
  .no { color: var(--red); font-weight: 700; }

  .terms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--line-soft);
    overflow: hidden;
  }

  .term {
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 12px;
    padding: 14px 16px;
    background: var(--panel);
  }

  .term dt {
    color: var(--orange);
    font: 700 16px/1.5 var(--serif);
  }

  .term dd { margin: 0; color: var(--ink-2); font-size: 14px; }

  .equation-card {
    margin-top: 26px;
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
  }

  .equation-card + .equation-card { margin-top: 16px; }

  .eq-label {
    margin-bottom: 14px;
    color: var(--muted);
    font: 700 11px/1 var(--mono);
    letter-spacing: .1em;
  }

  .eq {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .45em;
    overflow-x: auto;
    padding: 3px 0;
    color: var(--ink);
    font: 500 clamp(16px, 2.4vw, 22px)/1.65 var(--serif);
    font-variant-numeric: tabular-nums;
  }

  .eq.small { font-size: clamp(14px, 2vw, 18px); }
  .eq .op { color: var(--muted); }
  .eq .result { color: var(--orange); font-weight: 700; }

  .fraction {
    display: inline-grid;
    grid-template-rows: auto auto;
    text-align: center;
    line-height: 1.35;
    vertical-align: middle;
  }

  .fraction > span:first-child { padding: 0 .35em .06em; border-bottom: 1px solid currentColor; }
  .fraction > span:last-child { padding: .06em .35em 0; }

  .matrix {
    display: inline-grid;
    position: relative;
    grid-template-columns: repeat(3, auto);
    gap: .03em .75em;
    padding: .3em .65em;
    line-height: 1.45;
  }

  .matrix.one { grid-template-columns: auto; }
  .matrix::before, .matrix::after {
    content: "";
    position: absolute;
    inset-block: 0;
    width: .35em;
    border-block: 1.5px solid currentColor;
  }

  .matrix::before { left: 0; border-left: 1.5px solid currentColor; }
  .matrix::after { right: 0; border-right: 1.5px solid currentColor; }
  .matrix span { text-align: center; }

  .eq-explain {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
    color: var(--ink-2);
    font-size: 14px;
  }

  .steps {
    display: grid;
    gap: 12px;
    margin-top: 24px;
    counter-reset: derivation;
  }

  .step {
    position: relative;
    padding: 18px 18px 18px 58px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    counter-increment: derivation;
  }

  .step::before {
    content: counter(derivation);
    position: absolute;
    left: 17px;
    top: 17px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--orange-soft);
    color: var(--orange);
    font: 700 13px/1 var(--mono);
  }

  .step h3 { margin-bottom: 8px; font-size: 18px; }
  .step p { color: var(--ink-2); font-size: 14px; }

  .callout {
    margin-top: 24px;
    padding: 18px 20px;
    border-left: 4px solid var(--blue);
    background: var(--blue-soft);
    color: var(--ink-2);
  }

  .callout.warning { border-color: var(--red); background: var(--red-soft); }
  .callout strong { color: var(--ink); }

  .calculator {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 24px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
  }

  .field label {
    display: block;
    margin-bottom: 5px;
    color: var(--ink-2);
    font-size: 13px;
  }

  .field input {
    width: 100%;
    padding: 9px 11px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
  }

  .results {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 5px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--line);
    overflow: hidden;
  }

  .result-box { padding: 14px; background: var(--surface); }
  .result-box span { display: block; color: var(--muted); font-size: 12px; }
  .result-box output { color: var(--orange); font: 700 19px/1.5 var(--mono); }

  pre {
    margin: 24px 0 0;
    padding: 20px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #131a22;
    color: #dce5ee;
    font: 13px/1.7 var(--mono);
    tab-size: 4;
  }

  code { font-family: var(--mono); }
  .code-comment { color: #8298aa; }
  .code-name { color: #8fd4e8; }
  .code-value { color: #efb36f; }

  .checklist {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .check {
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
  }

  .check b { display: block; margin-bottom: 5px; }
  .check p { color: var(--ink-2); font-size: 14px; }

  .sources {
    margin: 24px 0 0;
    padding-left: 22px;
    color: var(--ink-2);
  }

  .sources li { margin: 12px 0; padding-left: 5px; }
  .sources span { display: block; color: var(--muted); font-size: 13px; }

  footer {
    margin-top: 80px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 860px) {
    header { grid-template-columns: 1fr; }
    .hero-figure { max-width: 620px; }
    .layout { grid-template-columns: 1fr; }
    nav { position: static; }
    nav ol { columns: 2; }
  }

  @media (max-width: 620px) {
    .page { width: min(100% - 22px, 1160px); }
    .cards, .terms, .checklist { grid-template-columns: 1fr; }
    .term { grid-template-columns: 50px 1fr; }
    .calculator { grid-template-columns: 1fr; }
    .results { grid-template-columns: 1fr; }
    nav ol { columns: 1; }
    .figure-head { flex-direction: column; }
  }

  @media print {
    :root { --ground: #fff; --surface: #fff; --panel: #fff; --ink: #000; --ink-2: #222; --muted: #555; --line: #aaa; --line-soft: #ccc; }
    .page { width: 100%; padding: 0; }
    .topbar, nav, .calculator { display: none; }
    header, .layout { display: block; }
    main { display: block; }
    section { break-inside: avoid; margin-top: 42px; }
    .hero-figure, .figure { box-shadow: none; }
    a { color: inherit; }
  }
</style>
</Fragment>
<div class="page">
  <div class="topbar">
    <div class="brand">ROVER VISION GUIDE / ARUCO RANGE</div>
    <button class="theme-button" id="themeButton" type="button" aria-label="表示テーマを切り替える">表示を切り替える</button>
  </div>

  <header>
    <div>
      <h1>ArUcoでローバーの距離を測る</h1>
      <p class="lede">起伏のある砂地でカメラが傾いても、既知サイズのArUcoマーカーと校正済みカメラから、カメラとマーカーの相対位置を各フレームで推定できます。</p>
      <div class="verdict"><strong>結論：</strong>カメラ中心からマーカー中心までの直線距離は推定できます。地面上の距離やローバー本体の位置には、追加の幾何情報が必要です。</div>
    </div>

    <figure class="hero-figure">
      <div class="figure-head"><span>状況</span><span>カメラが傾いても相対姿勢を解き直す</span></div>
      <div class="figure-body">
        <svg viewBox="0 0 560 380" role="img" aria-labelledby="heroTitle heroDesc">
          <title id="heroTitle">傾いたローバーとArUcoマーカー</title>
          <desc id="heroDesc">起伏のある地面に傾いたローバーがあり、カメラから垂直な板上のArUcoマーカーへ直線距離dが引かれている。</desc>
          <defs>
            <marker id="arrowOrange" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 Z" fill="var(--orange)"/></marker>
            <pattern id="sandDots" width="18" height="12" patternUnits="userSpaceOnUse"><circle cx="4" cy="5" r="1.2" fill="var(--muted)" opacity=".28"/><circle cx="14" cy="9" r=".8" fill="var(--muted)" opacity=".2"/></pattern>
          </defs>
          <path d="M18 315 C95 278 138 343 215 316 S350 292 408 318 S495 345 542 307 L542 375 L18 375 Z" fill="url(#sandDots)" stroke="var(--line)" stroke-width="2"/>
          <g transform="translate(122 284) rotate(9)">
            <rect x="-44" y="-35" width="132" height="48" rx="9" fill="var(--blue-soft)" stroke="var(--blue)" stroke-width="3"/>
            <circle cx="-16" cy="18" r="18" fill="var(--surface)" stroke="var(--ink-2)" stroke-width="4"/>
            <circle cx="65" cy="18" r="18" fill="var(--surface)" stroke="var(--ink-2)" stroke-width="4"/>
            <path d="M22 -35 L31 -72 L55 -72 L62 -34" fill="none" stroke="var(--ink-2)" stroke-width="5"/>
            <g transform="translate(48 -77)">
              <path d="M-24 -13 H11 L27 0 L11 13 H-24 Z" fill="var(--orange-soft)" stroke="var(--orange)" stroke-width="3"/>
              <circle cx="12" cy="0" r="6" fill="var(--orange)"/>
            </g>
          </g>
          <g>
            <rect x="432" y="72" width="12" height="258" rx="3" fill="var(--ink-2)" opacity=".6"/>
            <rect x="367" y="84" width="76" height="76" fill="white" stroke="var(--ink)" stroke-width="3"/>
            <rect x="376" y="93" width="58" height="58" fill="var(--ink)"/>
            <rect x="383" y="100" width="12" height="12" fill="white"/>
            <rect x="415" y="100" width="12" height="12" fill="white"/>
            <rect x="399" y="116" width="12" height="12" fill="white"/>
            <rect x="383" y="132" width="20" height="12" fill="white"/>
            <rect x="415" y="132" width="12" height="12" fill="white"/>
            <text x="405" y="61" text-anchor="middle" fill="var(--ink)" font-family="var(--sans)" font-size="14">既知サイズ L</text>
          </g>
          <line x1="188" y1="198" x2="394" y2="132" stroke="var(--orange)" stroke-width="3" marker-end="url(#arrowOrange)"/>
          <rect x="265" y="145" width="76" height="31" rx="15" fill="var(--panel)" stroke="var(--orange)"/>
          <text x="303" y="166" text-anchor="middle" fill="var(--orange)" font-family="var(--serif)" font-size="17">距離 d</text>
          <path d="M172 245 A45 45 0 0 1 204 217" fill="none" stroke="var(--violet)" stroke-width="2" stroke-dasharray="5 5"/>
          <text x="124" y="221" fill="var(--violet)" font-family="var(--sans)" font-size="13">pitch / roll が変化</text>
          <text x="94" y="354" fill="var(--muted)" font-family="var(--sans)" font-size="13">凹凸のある砂地</text>
        </svg>
      </div>
    </figure>
  </header>

  <div class="layout">
    <nav aria-label="目次">
      <p>CONTENTS</p>
      <ol>
        <li><a href="#distances">距離を区別する</a></li>
        <li><a href="#coordinates">座標系と記号</a></li>
        <li><a href="#projection">画像への投影</a></li>
        <li><a href="#pose">PnPの出力</a></li>
        <li><a href="#distance">距離の計算</a></li>
        <li><a href="#ground">地面距離への変換</a></li>
        <li><a href="#implementation">OpenCV実装</a></li>
        <li><a href="#field">砂地での精度</a></li>
        <li><a href="#sources">参照資料</a></li>
      </ol>
    </nav>

    <main>
      <section id="distances">
        <div class="section-head">
          <span class="section-no">01 / DISTANCE TYPES</span>
          <h2>「距離」は四つに分けて考える</h2>
        </div>
        <div class="prose">
          <p>ArUcoから直接得られるのは、マーカー座標系とカメラ座標系のあいだの回転と並進です。</p>
          <p>その並進から直線距離と光軸方向の奥行きを計算できますが、地面距離とローバー本体の距離には別の情報が要ります。</p>
        </div>

        <div class="table-wrap">
          <table>
            <thead><tr><th>求めたい量</th><th>意味</th><th>ArUco単体で可能か</th><th>追加条件</th></tr></thead>
            <tbody>
              <tr><td>直線距離 <var>d</var></td><td>カメラ中心からマーカー中心まで</td><td class="yes">可能</td><td>マーカー実寸、内部パラメータ、歪み係数</td></tr>
              <tr><td>奥行き <var>t<sub>z</sub></var></td><td>カメラの光軸方向の距離</td><td class="yes">可能</td><td>直線距離と同じ</td></tr>
              <tr><td>地面上の距離 <var>D</var></td><td>カメラ位置を地面へ投影した点から目標点まで</td><td class="conditional">条件付き</td><td>マーカーと地面の位置関係</td></tr>
              <tr><td>ローバー本体の距離</td><td>車体上の基準点から目標点まで</td><td class="no">単体では不可</td><td>カメラから車体基準点への変換</td></tr>
            </tbody>
          </table>
        </div>

        <div class="callout warning"><strong>「カメラの位置が変わる」の意味を分けます。</strong>ローバーごと傾いてカメラの世界座標が変わるだけなら、各フレームのPnPで対応できます。カメラが車体に対して動くなら、ローバー本体の位置を出すには、その動きを測るエンコーダなどが必要です。</div>
      </section>

      <section id="coordinates">
        <div class="section-head">
          <span class="section-no">02 / COORDINATE FRAMES</span>
          <h2>二つの座標系と記号</h2>
        </div>
        <div class="prose">
          <p>式を読む前に、点をどの座標系で表しているかを固定します。</p>
          <p><strong>マーカー座標系 M</strong>はマーカー中心を原点とし、<var>X<sub>M</sub></var>を右、<var>Y<sub>M</sub></var>を上、<var>Z<sub>M</sub></var>をマーカー面の手前向きに取ります。</p>
          <p><strong>カメラ座標系 C</strong>はレンズの投影中心を原点とし、<var>X<sub>C</sub></var>を画像の右、<var>Y<sub>C</sub></var>を画像の下、<var>Z<sub>C</sub></var>を光軸の前向きに取ります。</p>
        </div>

        <figure class="figure" style="margin-top:24px">
          <div class="figure-head"><span>座標系</span><span>同じ点でも数値は座標系ごとに異なる</span></div>
          <div class="figure-body">
            <svg viewBox="0 0 760 355" role="img" aria-labelledby="coordTitle coordDesc">
              <title id="coordTitle">マーカー座標系とカメラ座標系</title>
              <desc id="coordDesc">左にカメラ座標軸、右にマーカー座標軸が描かれ、両者を回転Rと並進tで結ぶ。</desc>
              <defs>
                <marker id="axisArrow" markerWidth="8" markerHeight="8" refX="6.5" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="context-stroke"/></marker>
                <marker id="linkArrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="var(--orange)"/></marker>
              </defs>
              <g transform="translate(145 220)">
                <path d="M-52 -25 H20 L52 0 L20 25 H-52 Z" fill="var(--blue-soft)" stroke="var(--blue)" stroke-width="3"/>
                <circle cx="27" cy="0" r="10" fill="var(--blue)"/>
                <circle cx="0" cy="0" r="4" fill="var(--ink)"/>
                <line x1="0" y1="0" x2="100" y2="0" stroke="var(--red)" stroke-width="2.5" marker-end="url(#axisArrow)"/>
                <line x1="0" y1="0" x2="0" y2="80" stroke="var(--green)" stroke-width="2.5" marker-end="url(#axisArrow)"/>
                <line x1="0" y1="0" x2="62" y2="-62" stroke="var(--blue)" stroke-width="2.5" marker-end="url(#axisArrow)"/>
                <text x="108" y="5" fill="var(--red)" font-family="var(--serif)" font-size="17">X<tspan baseline-shift="sub" font-size="11">C</tspan></text>
                <text x="6" y="89" fill="var(--green)" font-family="var(--serif)" font-size="17">Y<tspan baseline-shift="sub" font-size="11">C</tspan></text>
                <text x="68" y="-67" fill="var(--blue)" font-family="var(--serif)" font-size="17">Z<tspan baseline-shift="sub" font-size="11">C</tspan></text>
                <text x="-38" y="57" fill="var(--ink-2)" font-family="var(--sans)" font-size="14">カメラ座標系 C</text>
              </g>
              <g transform="translate(607 135)">
                <rect x="-60" y="-60" width="120" height="120" fill="var(--surface)" stroke="var(--ink-2)" stroke-width="3"/>
                <rect x="-43" y="-43" width="86" height="86" fill="var(--ink)"/>
                <rect x="-31" y="-31" width="19" height="19" fill="var(--panel)"/>
                <rect x="12" y="-31" width="19" height="19" fill="var(--panel)"/>
                <rect x="-9" y="-9" width="19" height="19" fill="var(--panel)"/>
                <rect x="-31" y="13" width="28" height="18" fill="var(--panel)"/>
                <rect x="13" y="13" width="18" height="18" fill="var(--panel)"/>
                <circle cx="0" cy="0" r="4" fill="var(--orange)"/>
                <line x1="0" y1="0" x2="100" y2="0" stroke="var(--red)" stroke-width="2.5" marker-end="url(#axisArrow)"/>
                <line x1="0" y1="0" x2="0" y2="-95" stroke="var(--green)" stroke-width="2.5" marker-end="url(#axisArrow)"/>
