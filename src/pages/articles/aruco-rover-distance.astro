                <text x="108" y="5" fill="var(--red)" font-family="var(--serif)" font-size="17">X<tspan baseline-shift="sub" font-size="11">M</tspan></text>
                <text x="6" y="-101" fill="var(--green)" font-family="var(--serif)" font-size="17">Y<tspan baseline-shift="sub" font-size="11">M</tspan></text>
                <text x="-83" y="73" fill="var(--blue)" font-family="var(--serif)" font-size="17">Z<tspan baseline-shift="sub" font-size="11">M</tspan></text>
