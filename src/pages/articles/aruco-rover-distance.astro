              <text x="472" y="227" fill="var(--green)" font-family="var(--serif)" font-size="19">H</text>
              <circle cx="185" cy="198" r="9" fill="var(--blue)"/>
              <text x="113" y="180" fill="var(--ink)" font-family="var(--sans)" font-size="14">カメラ中心 C<tspan baseline-shift="sub" font-size="10">M</tspan></text>
              <line x1="185" y1="207" x2="185" y2="315" stroke="var(--blue)" stroke-width="2" stroke-dasharray="7 6"/>
              <circle cx="185" cy="315" r="6" fill="var(--blue)"/>
              <circle cx="563" cy="315" r="6" fill="var(--orange)"/>
              <line x1="196" y1="344" x2="552" y2="344" stroke="var(--orange)" stroke-width="3" marker-start="url(#groundArrow)" marker-end="url(#groundArrow)"/>
              <text x="374" y="374" text-anchor="middle" fill="var(--orange)" font-family="var(--serif)" font-size="19">地面距離 D</text>
              <line x1="185" y1="198" x2="555" y2="135" stroke="var(--violet)" stroke-width="2.5"/>
