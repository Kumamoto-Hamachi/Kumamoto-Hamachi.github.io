              <defs>
                <marker id="groundArrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="var(--orange)"/></marker>
              </defs>
              <path d="M30 315 H730" stroke="var(--ink-2)" stroke-width="3"/>
              <path d="M30 316 C100 300 140 330 210 315 S335 303 400 315 S535 329 610 315 S685 307 730 315" fill="none" stroke="var(--muted)" stroke-width="1.5"/>
              <rect x="605" y="70" width="14" height="247" fill="var(--ink-2)" opacity=".55"/>
              <rect x="520" y="88" width="86" height="86" fill="var(--surface)" stroke="var(--ink)" stroke-width="3"/>
              <rect x="534" y="102" width="58" height="58" fill="var(--ink)"/>
              <rect x="542" y="110" width="15" height="15" fill="var(--panel)"/>
              <rect x="570" y="110" width="14" height="15" fill="var(--panel)"/>
              <rect x="557" y="127" width="14" height="14" fill="var(--panel)"/>
              <rect x="542" y="145" width="20" height="8" fill="var(--panel)"/>
              <rect x="576" y="143" width="8" height="10" fill="var(--panel)"/>
              <circle cx="563" cy="131" r="5" fill="var(--orange)"/>
