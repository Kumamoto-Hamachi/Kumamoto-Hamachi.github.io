.concept h3{margin-bottom:12px}.concept p,.basis-card p{margin:0;color:var(--ink2);font-size:13.5px}
.basis-card b{display:block;margin-bottom:8px;color:var(--rotate);font-family:var(--mono)}
.derive{display:flex;flex-direction:column;gap:12px;margin-top:7px}
.derive .equation{padding:12px 14px;border:1px solid var(--soft);background:var(--surface)}
.basis-x{color:var(--move);font-weight:700}.basis-y{color:var(--camera);font-weight:700}
.fig{border:1px solid var(--line);background:var(--panel)}
.fig-bar{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;padding:9px 16px;border-bottom:1px solid var(--soft);background:var(--surface);color:var(--muted);font:11px var(--mono);letter-spacing:.08em}
