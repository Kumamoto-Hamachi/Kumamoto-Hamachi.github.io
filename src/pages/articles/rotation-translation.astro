---
// 回転行列と並進ベクトル（rotation-translation-guide.html から移植）
import ArticlePage from '../../layouts/ArticlePage.astro';
---

<ArticlePage id="rotation-translation" description="回転行列と並進ベクトルを、図と具体的な数値計算で基礎から学ぶ線形代数入門ガイド。">
<Fragment slot="head">
<style is:inline>
:root{
  --ground:#e7eaee;--surface:#f1f3f6;--panel:#fdfdfe;--ink:#151a22;--ink2:#454f5e;
  --muted:#78828f;--line:#c6ccd5;--soft:#dde1e7;--rotate:#6555a3;--move:#c26c15;
  --world:#3f7a52;--camera:#2e7d9a;--warn:#ac403a;
  --mincho:"Hiragino Mincho ProN","Yu Mincho",YuMincho,"Noto Serif CJK JP","Noto Serif JP",serif;
  --gothic:"Hiragino Sans","Noto Sans CJK JP","Noto Sans JP","Yu Gothic",Meiryo,system-ui,sans-serif;
  --mono:ui-monospace,"SF Mono",SFMono-Regular,"Cascadia Code","Roboto Mono",Menlo,Consolas,monospace
}
@media(prefers-color-scheme:dark){:root{
  --ground:#10141a;--surface:#161b23;--panel:#1b212a;--ink:#e4e9f0;--ink2:#aab4c2;
  --muted:#7c8695;--line:#333c48;--soft:#262e39;--rotate:#b2a4ed;--move:#efa85c;
  --world:#74b98c;--camera:#5ab2ce;--warn:#e07a72
}}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--ground);color:var(--ink);font:15px/1.85 var(--gothic);-webkit-font-smoothing:antialiased}
.wrap{width:min(1140px,calc(100% - 32px));margin:auto;padding:clamp(28px,5vw,64px) 0 88px;display:flex;flex-direction:column;gap:76px}
.topline{display:flex;justify-content:space-between;gap:20px;padding-bottom:16px;border-bottom:1px solid var(--line);color:var(--muted);font:10.5px var(--mono);letter-spacing:.12em;text-transform:uppercase}
.topline a{color:inherit;text-decoration:none}.topline a:hover{color:var(--ink)}
header,.sec-head,section{display:flex;flex-direction:column}header{gap:20px}section{gap:26px}.sec-head{gap:12px}
.eyebrow,.sec-no{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase}
.eyebrow{color:var(--rotate);font-weight:700}.sec-no{color:var(--muted)}
h1,h2,h3{margin:0;font-family:var(--mincho);font-weight:600;letter-spacing:.02em}h1,h2{text-wrap:balance}
h1{max-width:14em;font-size:clamp(32px,5.5vw,49px);line-height:1.3;word-break:keep-all}
h2{font-size:clamp(22px,3.2vw,29px);line-height:1.5}h3{font-size:clamp(17px,2.3vw,21px)}
.lede,.prose{max-width:43em;margin:0;color:var(--ink2)}.lede strong,.prose strong{color:var(--ink);font-weight:650}
code,.mono{font-family:var(--mono);font-size:.93em}
.goal-strip{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}
.goal{min-height:116px;padding:18px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--panel)}
.goal b{display:block;margin-bottom:7px;color:var(--rotate);font:700 11px var(--mono);letter-spacing:.1em}
.goal span{color:var(--ink2);font-size:13.5px;line-height:1.65}
.equation{display:flex;align-items:center;gap:.55em;flex-wrap:wrap;overflow-x:auto;padding:5px 0;font:clamp(14px,2vw,18px)/1.5 var(--mono);font-variant-numeric:tabular-nums}
.op{color:var(--muted)}.hot-r{color:var(--rotate);font-weight:700}.hot-t{color:var(--move);font-weight:700}.hot-c{color:var(--camera);font-weight:700}
.mat{display:inline-grid;position:relative;gap:.14em .78em;padding:.4em .65em;line-height:1.45;vertical-align:middle}
.mat:before,.mat:after{content:"";position:absolute;top:0;bottom:0;width:.38em;border:1.5px solid var(--ink2)}
.mat:before{left:0;border-right:0}.mat:after{right:0;border-left:0}
