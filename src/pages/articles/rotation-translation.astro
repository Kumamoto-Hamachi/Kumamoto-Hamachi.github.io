.callout strong{color:var(--ink)}.callout--camera{border-left-color:var(--camera)}.callout p{margin:0}.callout p+p{margin-top:10px}
.compare{width:100%;border-collapse:collapse;border:1px solid var(--line);background:var(--panel)}
.compare th,.compare td{padding:13px 15px;border-bottom:1px solid var(--soft);text-align:left;vertical-align:top}
.compare th{background:var(--surface);color:var(--muted);font:600 10.5px var(--mono);letter-spacing:.08em}
.compare td{color:var(--ink2);font-size:13.5px}.compare td:first-child{color:var(--ink);font-weight:650}
.flow{display:flex;gap:11px;align-items:stretch;overflow-x:auto}.flow-box{flex:1 0 180px;padding:15px;border:1px solid var(--line);background:var(--panel);text-align:center;font:13px var(--mono)}
.flow-box small{display:block;margin-top:5px;color:var(--muted);font-size:10px}.flow-arrow{align-self:center;color:var(--muted);font-family:var(--mono)}
.quiz{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}details{border:1px solid var(--line);background:var(--panel)}
summary{padding:16px;cursor:pointer;font-weight:650}details p{margin:0;padding:0 16px 17px;color:var(--ink2);font-size:13.5px}
.next{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:clamp(22px,4vw,34px);border:1px solid var(--line);background:var(--panel);color:inherit;text-decoration:none}
.next:hover{background:var(--surface)}.next small{display:block;color:var(--muted);font:10px var(--mono);letter-spacing:.1em}.next b{display:block;margin-top:5px;font:600 21px var(--mincho)}.next .arrow{color:var(--rotate);font:24px var(--mono)}
footer{padding-top:18px;border-top:1px solid var(--line);color:var(--muted);font:10px/1.8 var(--mono);letter-spacing:.06em}
@media(max-width:760px){.goal-strip,.quiz,.visual-grid,.concept-grid,.basis-grid{grid-template-columns:1fr}.topline span:last-child{display:none}.compare{min-width:650px}.table-scroll{overflow-x:auto}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
