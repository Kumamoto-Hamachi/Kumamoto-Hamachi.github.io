.ctrl{display:flex;flex-direction:column;gap:5px}.ctrl-head{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font:11.5px var(--mono)}
output{color:var(--ink);font-size:13px;font-weight:700}input[type=range]{width:100%;height:24px;margin:0;accent-color:var(--rotate);cursor:ew-resize}
