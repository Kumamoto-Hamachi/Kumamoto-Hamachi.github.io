---
import { articleUrl, categoryUrl, seriesUrl, formatDate, type Article } from '../lib/content';

interface Props {
  article: Article;
  categoryName: string;
  seriesTitle?: string;
  accent?: 'blue' | 'green' | 'violet' | 'orange';
}

const { article, categoryName, seriesTitle, accent = 'blue' } = Astro.props;
const { title, description, label, category, publishedAt, series, seriesOrder } = article.data;
const date = formatDate(publishedAt);
---

<li class="card" style={`--accent: var(--${accent})`}>
  <div class="meta">
    <span>{label ?? ''}</span>
    <time datetime={date}>{date}</time>
  </div>
  <h3><a class="stretched" href={articleUrl(article.id)}>{title}</a></h3>
  <p class="desc">{description}</p>
  <p class="tags">
    <a href={categoryUrl(category.id)}>{categoryName}</a>
    {
      series && (
        <a href={seriesUrl(series.id)}>
          {seriesTitle} #{seriesOrder}
        </a>
      )
    }
  </p>
</li>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 230px;
    padding: clamp(22px, 4vw, 32px);
    overflow: hidden;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--panel);
    transition: background-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform .24s ease;
  }

  .card:hover,
  .card:focus-within {
    z-index: 1;
    background: var(--surface);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .card:hover::before,
  .card:focus-within::before { transform: scaleY(1); }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .meta span { color: var(--accent); font-weight: 700; }

  h3 {
    margin: 0 0 12px;
    font-family: var(--mincho);
    font-size: clamp(20px, 3vw, 25px);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: .02em;
    text-wrap: balance;
  }

  .stretched { color: inherit; text-decoration: none; }
  .stretched:focus-visible { outline: none; }
  /* カード全体を記事へのリンクにする。カテゴリ・シリーズのリンクはこの上に出す */
  .stretched::after { content: ''; position: absolute; inset: 0; }

  .desc {
    margin: 0 0 20px;
    color: var(--ink-2);
    line-height: 1.85;
  }

  .tags {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: auto 0 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .06em;
  }

  .tags a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .tags a:hover { color: var(--ink); border-color: var(--ink-2); }

  @media (prefers-reduced-motion: reduce) {
    .card, .card::before { transition: none; }
  }
</style>
